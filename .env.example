PORT=8080

# ── 本地 PostgreSQL ──────────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=Asd123@
# DB_NAME=go_web
# DB_SSLMODE=disable

# ── AWS RDS ──────────────────────────────────────────────────────
# 下载 Amazon RDS CA 证书包后将路径填入 DB_SSL_ROOT_CERT
#   curl -O https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_HOST=database-1.ct8ym8caacv7.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres
DB_SSLMODE=verify-full
DB_SSL_ROOT_CERT=./global-bundle.pem
# DB_PASSWORD 与 DB_PASSWORD_SECRET_ARN 二选一：
# 直接填写密码（不推荐）：
# DB_PASSWORD=
# 从 AWS Secrets Manager 自动获取（推荐）：
DB_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:183047559773:secret:rds!db-df55855c-b5a7-4570-a808-16d23ab471e9-njINjO

DB_TIMEZONE=UTC
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=30
DB_CONN_MAX_LIFETIME_MINUTES=30