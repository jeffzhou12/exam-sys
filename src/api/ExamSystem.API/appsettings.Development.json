{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=exam_system_dev;Username=postgres;Password=__set_via_user_secrets__"
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "ExamSystem",
    "Audience": "ExamSystemClient",
    "SecretKey": "dev-secret-key-change-in-production-min32chars!!",
    "ExpirationMinutes": 480
  },
  "AuthProtection": {
    "Captcha": {
      "Enabled": true,
      "BypassInDevelopment": false
    }
  },
  "AuditLog": {
    "Enabled": false
  },
  "TwilioSms": {
    "Enabled": false,
    "AccountSid": "",
    "AuthToken": "",
    "FromPhoneNumber": "",
    "MessagingServiceSid": "",
    "AppName": ""
  }
}
