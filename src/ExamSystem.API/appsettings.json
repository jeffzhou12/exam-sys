{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/exam-system-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj} | MachineName={MachineName} ThreadId={ThreadId}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AuditLog": {
    "Enabled": true
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=exam_system;Username=postgres;Password=your_password"
  },
  "Redis": {
    "Connection": "localhost:6379"
  },
  "AI": {
    "Primary": {
      "BaseUrl": "https://api.deepseek.com/v1",
      "ApiKey": "__set_via_user_secrets_or_env__",
      "ChatModel": "deepseek-chat"
    },
    "Fallback": {
      "BaseUrl": "https://api.siliconflow.cn/v1",
      "ApiKey": "__set_via_user_secrets_or_env__",
      "ChatModel": "deepseek-ai/DeepSeek-V3",
      "EmbeddingModel": "BAAI/bge-m3"
    }
  },
  "Jwt": {
    "Issuer": "ExamSystem",
    "Audience": "ExamSystemClient",
    "SecretKey": "__set_via_user_secrets_or_env__",
    "ExpirationMinutes": 60
  },
  "AdminUsers": [
    {
      "Username": "admin",
      "PasswordHash": "__set_via_user_secrets_or_env__",
      "Role": "Admin"
    }
  ],
  "AWS": {
    "S3": {
      "BucketName": "",
      "Region": "ap-northeast-1",
      "PresignedUrlExpirationMinutes": 60
    }
  }
}
