default_platform(:ios)

# ── iOS ───────────────────────────────────────────────────────────────────────
platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # 1. 证书 & Provisioning Profile（使用 App Store Connect API）
    api_key = app_store_connect_api_key(
      key_id:      ENV["ASC_KEY_ID"],
      issuer_id:   ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],  # base64 编码的 .p8 内容
      is_key_content_base64: true,
    )

    # 2. 自动管理签名
    match(
      type: "appstore",
      app_identifier: "com.examsystem.app",
      api_key: api_key,
      readonly: true,
    )

    # 3. 构建版本号自增
    increment_build_number(
      build_number: number_of_commits,
      xcodeproj: "ios/Runner.xcodeproj",
    )

    # 4. Flutter 构建
    sh("flutter build ipa --release --dart-define=API_BASE_URL=#{ENV['API_BASE_URL']}")

    # 5. 上传 TestFlight
    upload_to_testflight(
      ipa: "build/ios/ipa/exam_system.ipa",
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload to App Store production"
  lane :release do
    # 复用 beta 流程，然后提交审核
    beta
    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
    )
  end
end

# ── Android ───────────────────────────────────────────────────────────────────
platform :android do
  desc "Build and upload to Google Play Internal Track"
  lane :beta do
    # Flutter 构建 App Bundle
    sh("flutter build appbundle --release --dart-define=API_BASE_URL=#{ENV['API_BASE_URL']}")

    # 上传到 Internal Testing
    upload_to_play_store(
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      release_status: "draft",
    )
  end

  desc "Promote Internal → Production"
  lane :release do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
    )
  end
end
